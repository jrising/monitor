# Copy to monitor.env (same folder as server.py) and fill in. Never put this file in a public web folder.

# Password for the dashboard and the feed editor. Use something long; a passphrase is fine.
MONITOR_PASSWORD=

# Optional extra token with access to every panel. Normally you create per-machine tokens in the
# dashboard (Edit feeds → Tokens) instead and leave this blank.
MONITOR_TOKEN=

# "external" on DreamHost shared hosting (checks run from a cron job); "internal" on a VPS/your own server.
MONITOR_SCHEDULER=external

# Seconds between dashboard refreshes / agent check-ins. On DreamHost (CGI) setup.sh sets 30 and 60.
# MONITOR_REFRESH=5
# MONITOR_AGENT_INTERVAL=15

# Time zone used for cron-style schedules such as "0 9 * * 1-5".
MONITOR_TZ=America/New_York


# Secrets for checks: a check can use ${SECRET_NAME} (e.g. in an API header) and gets this value,
# so keys never appear in the feed list.
# SECRET_EXAMPLE_KEY=

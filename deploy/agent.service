# Keeps the monitor agent running on a Linux machine, as your user (no root needed):
#   mkdir -p ~/.config/systemd/user && cp deploy/agent.service ~/.config/systemd/user/monitor-agent.service
#   (edit the path below if the clone isn't ~/projects/monitor)
#   systemctl --user enable --now monitor-agent
#   loginctl enable-linger $USER     # keep it running when you're logged out (servers)
[Unit]
Description=Monitor agent

[Service]
ExecStart=/usr/bin/python3 %h/projects/monitor/agent/monitor_agent.py agent
Restart=always
RestartSec=30

[Install]
WantedBy=default.target

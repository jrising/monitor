#!@PYTHON@
# Monitor CGI launcher, generated by deploy/dreamhost/setup.sh. This is the only code in the web
# folder; the app, its settings and data live in @APP@, which the web server can't serve.
import os
import sys
from urllib.parse import unquote, urlsplit

APP = "@APP@"
sys.path.insert(0, APP)
os.chdir(APP)
os.environ.setdefault("MONITOR_SCHEDULER", "external")

# .htaccess sends every URL to this script; give the app the URL that was actually requested.
os.environ["SCRIPT_NAME"] = ""
os.environ["PATH_INFO"] = unquote(urlsplit(os.environ.get("REQUEST_URI", "/")).path) or "/"
for key in ("HTTP_AUTHORIZATION", "HTTP_X_TOKEN"):  # Apache may only pass these on after a rewrite
    if not os.environ.get(key) and os.environ.get("REDIRECT_" + key):
        os.environ[key] = os.environ["REDIRECT_" + key]

try:
    from wsgiref.handlers import CGIHandler

    from a2wsgi import ASGIMiddleware

    import server

    server.init()
    CGIHandler().run(ASGIMiddleware(server.app))
except Exception:  # show something useful instead of a bare "500 Internal Server Error"
    import traceback
    sys.stdout.write("Status: 500 Internal Server Error\r\nContent-Type: text/plain\r\n\r\n")
    sys.stdout.write("The monitor app failed to start. Run deploy/dreamhost/setup.sh on the server for details.\n")
    traceback.print_exc(file=sys.stderr)  # goes to the site's error log

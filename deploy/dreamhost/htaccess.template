# Generated by deploy/dreamhost/setup.sh. Sends every request to the monitor app (monitor.cgi).
Options -Indexes +ExecCGI
AddHandler cgi-script .cgi
DirectoryIndex monitor.cgi

RewriteEngine On

# HTTPS only (turn on the free Let's Encrypt certificate for the domain in the DreamHost panel)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Hand the Authorization header to the app (Apache drops it for CGI by default)
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Everything goes to the app; no other file in this folder is served
RewriteCond %{REQUEST_URI} !^/monitor\.cgi
RewriteRule ^ monitor.cgi [L]
